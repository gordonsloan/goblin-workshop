[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[scene_navigator]

main_menu_scene_path="res://src/ui/main_menu/main_menu.tscn"
settings_scene_path="res://src/ui/settings_menu/settings_menu.tscn"
start_scene_path="res://src/scenes/world.tscn"
use_transitions=true
transition_scene_path="res://src/ui/transitions/fade_transition.tscn"
credits_scene_path="res://src/ui/credits_menu/credits_menu.tscn"

[starter_template]

display/default_window_mode=0
display/default_window_mode.windows=1
credits/creator_handle="Nodrogagon"
